COMPOSE_PROJECT_NAME=onenet-dsp-connector

# WebApp settings
APP_NAME=TwinEU_DSP_

#TLS settings
CONNECTOR_A_KEYSTORE_NAME=connector-a.jks
CONNECTOR_A_KEY_PASSWORD=password
CONNECTOR_A_KEYSTORE_PASSWORD=password
CONNECTOR_A_KEYSTORE_ALIAS=connector-a

CONNECTOR_B_KEYSTORE_NAME=connector-b.jks
CONNECTOR_B_KEY_PASSWORD=password
CONNECTOR_B_KEYSTORE_PASSWORD=password
CONNECTOR_B_KEYSTORE_ALIAS=connector-b

#TRUSTSTORE (used also by IDSCP2)
TRUSTSTORE_NAME=truststore.jks
TRUSTSTORE_PASSWORD=password

#DAPS
DAPS_KEYSTORE_NAME=
DAPS_KEYSTORE_PASSWORD=
DAPS_KEYSTORE_ALIAS=

# Connector Endpoints. Default local environment values. Change these to the public IP/DNS in production environment
CONNECTOR_A_ENDPOINT_API_URL=http://connector-a:8080
CONNECTOR_B_ENDPOINT_API_URL=http://connector-b:8080

CONNECTOR_BASIC_AUTHENTICATION=YWRtaW5AbWFpbC5jb206cGFzc3dvcmQ=

CENTRALIZED_SERVICES_API_URL=http://4.232.76.64/middleware-dev/api
#CENTRALIZED_SERVICES_API_URL=http://4.232.76.64/insieme-middleware-dev/api

# Default local environment value. Change this to the public S3 endpoint if using a reverse proxy
S3_EXTERNAL_PRESIGNED_ENDPOINT=http://minio:9000

PUSH_ENABLED=true